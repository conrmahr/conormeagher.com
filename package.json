{
  "name": "11ty-portfolio",
  "version": "3.1.0",
  "description": "Minimal Poftfolio / blog template built with eleventy & tailwindcss.",
  "scripts": {
    "serve": "ELEVENTY_ENV=dev npx eleventy --serve",
    "start": "npm run serve",
    "build": "ELEVENTY_ENV=dev npx eleventy",
    "build:prod": "ELEVENTY_ENV=prod npx eleventy",
    "build:css": "tailwindcss -i src/css/tailwind.css -o src/css/styles.css --minify"
  },
  "keywords": [
    "11ty",
    "tailwindcss",
    "eleventy",
    "purgecss"
  ],
  "author": "kailoon",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "nunjucks": "^3.2.4",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@11ty/eleventy-upgrade-help": "^3.0.2",
    "eleventy-plugin-embed-everything": "^1.21.2",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0"
  }
}
